# Enforce the Node version this project is pinned to.
#
# package.json `engines` declares >=22.12.0 <24.0.0 and .nvmrc pins 22.23.1,
# but without this flag npm treats `engines` as advisory and will happily
# install and build on an unsupported runtime.
#
# Why it matters: Next 14.2.5 bundles a webpack whose WASM hasher
# (WasmHash) crashes on Node 24, producing intermittent build failures
# (ERR_INVALID_ARG_TYPE, "Cannot read properties of undefined"). See
# AGENTS.md Phase 46 and the workaround comments in next.config.mjs.
engine-strict=true
