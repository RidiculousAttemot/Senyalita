#!/bin/sh
#
# Refuse to push commits containing secret-shaped values.
#
# Exists because a live Supabase service_role JWT reached origin/main in
# 02b57013 (2026-06-19) and stayed publicly readable for six weeks. The working
# tree was clean the whole time -- the secret was in the range being pushed,
# not in HEAD. So this scans THE RANGE, never the working tree.
#
# stdin gives one line per ref being pushed:
#   <local ref> <local oid> <remote ref> <remote oid>

ZERO='0000000000000000000000000000000000000000'
status=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
	# Branch deletion: nothing is being published.
	[ "$local_oid" = "$ZERO" ] && continue

	if [ "$remote_oid" = "$ZERO" ]; then
		# New branch. Everything not already on some remote is new here.
		range="$local_oid --not --remotes"
	else
		range="$remote_oid..$local_oid"
	fi

	node scripts/audit-secrets.mjs --range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
	cat >&2 <<'EOF'

────────────────────────────────────────────────────────────────────────
PUSH BLOCKED — a secret-shaped value is in the commits you are pushing.

Removing it from the working tree is NOT enough. The value lives in a
commit in this range; you need to amend, rebase, or drop that commit so
it never reaches the remote. Once pushed to a public repo, treat the
credential as compromised and ROTATE it -- deleting it afterwards does
not un-publish it.

You can bypass this check:

    git push --no-verify

That is a real and sometimes correct option -- if this is a false
positive, use it, then add the placeholder form to PLACEHOLDER in
scripts/audit-secrets.mjs so the next person is not stopped too.

This hook is the first layer and it is local-only: it cannot protect a
push from another machine or another clone. Enable GitHub push
protection as the second layer:
    Settings -> Code security -> Secret scanning -> Push protection

See ROTATION.md §0.5 for how the six-week exposure happened.
────────────────────────────────────────────────────────────────────────
EOF
fi

exit "$status"
