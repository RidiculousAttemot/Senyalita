# Dependencies
node_modules/
.npm

# Next.js & build outputs
# Leading slashes anchor these to the repo root. Unanchored, a bare "build/"
# also ignores any nested directory of that name — which is how
# src/app/admin/(dashboard)/models/ silently never reached the repository.
.next/
/out/
/dist/
/build/

# TypeScript incremental build cache — generated, must not be committed.
# A stale committed copy makes `tsc --noEmit` fail with TS5033
# ("Could not write file ... tsconfig.tsbuildinfo").
*.tsbuildinfo
tsconfig.tsbuildinfo

# Agent worktrees (git worktrees created under the repo root)
.claude/worktrees/

# Scratch output from the extraction scripts (TMP_DIR in
# scripts/extract-holistic-videos.mjs and friends). There was no rule here at
# all, so 15,381 decoded PNG frames — 35GB — were committed. Anchored to the
# repo root so a nested "tmp" directory that is real source stays trackable.
/tmp/

# Datasets
datasets/raw/**/*.json
datasets/processed/**/*.json
datasets/raw/**/*.ndjson
datasets/processed/**/*.ndjson
datasets/archive/

# Source recordings. Only .json/.ndjson were excluded before, so video matched
# nothing and 185 files under datasets/raw/user_videos are already tracked --
# which is a large part of why .git is 2.3 GB. Those stay tracked; removing
# them is a history question, not an ignore-rule one. This keeps new batches
# out: an import is ~1.1 GB, and the deploy exclusions in .vercelignore and
# .dockerignore already keep the whole directory out of builds either way.
datasets/**/*.mp4
datasets/**/*.MOV
datasets/**/*.mov
datasets/**/*.webm
datasets/**/*.avi

!datasets/raw/**/.gitkeep
!datasets/processed/**/.gitkeep

# Models and training artifacts
# Anchored: this is the root ML artefact directory. Unanchored it also matched
# src/app/admin/(dashboard)/models/, so those pages existed on one machine and
# in no clone or deployment.
/models/
*.joblib
*.pkl
*.h5
.weights/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Anchored: "env"/"ENV" are plausible source directory names.
/env/
/venv/
/ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Vercel
.vercel

# Kaggle cache
~/.cache/kagglehub/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/


# Local production-build harness output (NEXT_DIST_DIR=.next-prod). Kept out
# of git so it cannot be swept into a commit, and out of the deploy/image
# contexts for the same reason .next is.
.next-prod/
