# SignLangVisual environment variables
#
# Local development: copy to .env.local and fill in the values.
# Vercel: configure in the project's Environment Variables settings.
#
# Supabase project: https://tfhpcbasfugqaimcoios.supabase.co

NEXT_PUBLIC_SUPABASE_URL=https://tfhpcbasfugqaimcoios.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app. Used for absolute redirect URLs
# (e.g. password reset emails). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin password for local/developer admin access.
# Set this to any password, then restart the dev server.
# Access admin at http://localhost:3000/admin
# This is a simple local protection only — NOT production auth.
# Supabase/auth should replace this for real deployments.
ADMIN_PASSWORD=change-me
