# SignLangVisual environment variables
#
# Local development: copy to .env.local and fill in the values.
# Vercel: configure in the project's Environment Variables settings.
#
# NEVER commit real values. .env.local is gitignored; keep it that way.
# NEXT_PUBLIC_* variables are exposed to the browser by Next.js — never put a
# secret behind that prefix.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key. Safe to expose; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses ALL row-level security. Server-side only — never ship to a
# client, never hardcode in a script, never paste into a chat or an issue.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (required only for migrations) -------------------------------
# Postgres connection string, used by scripts/db-apply.mjs and db-migrate.mjs.
# SECRET: embeds the database password.
# Direct connections (db.<ref>.supabase.co) are IPv6-only; on IPv4 networks use
# the Supavisor pooler in SESSION mode (port 5432) — transaction mode (6543)
# does not reliably support DDL.
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- App -------------------------------------------------------------------
# Public URL of the deployed app. Used for absolute redirect URLs
# (e.g. password reset emails). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Animation assets ------------------------------------------------------
# Optional. Serves landmark JSON from datasets/processed/user_holistic_assets
# when a gloss has no published Supabase asset. Defaults ON outside production;
# those files are gitignored and never deployed, so it is a development-only
# convenience. Set to 0 to reproduce production behaviour locally.
# ANIMATION_LOCAL_FALLBACK=0

# --- MediaPipe models (optional) -------------------------------------------
# Override the CDN-hosted task bundles, e.g. to self-host them.
# NEXT_PUBLIC_MEDIAPIPE_HAND_MODEL_URL=
# NEXT_PUBLIC_MEDIAPIPE_HOLISTIC_MODEL_URL=

# --- AI reply generation (optional) ----------------------------------------
# Only needed for the conversational reply features. SECRET.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# AI_API_BASE_URL=
